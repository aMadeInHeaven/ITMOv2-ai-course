    {
      "parameters": {
        "jsCode": "const sourceNodes = [\n  ['bug', 'HTTP — weekly bug'],\n  ['task', 'HTTP — weekly task'],\n  ['feature', 'HTTP — weekly feature'],\n  ['needs-triage', 'HTTP — weekly needs-triage'],\n];\n\nconst byType = {};\nconst byAuthor = {};\nlet total = 0;\n\nfor (const [type, nodeName] of sourceNodes) {\n  const issues = $(nodeName).first().json.items ?? [];\n  byType[type] = issues.length;\n  total += issues.length;\n\n  for (const issue of issues) {\n    const author = issue.user?.login ?? 'unknown';\n    byAuthor[author] = (byAuthor[author] ?? 0) + 1;\n  }\n}\n\nconst esc = (value) => String(value)\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\\\"/g, '&quot;');\n\nconst typeRowsHtml = Object.entries(byType)\n  .map(([type, count]) => `<tr><td>${esc(type)}</td><td>${count}</td></tr>`)\n  .join('');\n\nconst authorRowsHtml = Object.entries(byAuthor)\n  .sort(([, left], [, right]) => right - left)\n  .map(([author, count]) => `<tr><td>${esc(author)}</td><td>${count}</td></tr>`)\n  .join('') || '<tr><td colspan=\\\"2\\\">За эту неделю Issues не создавались</td></tr>';\n\nconst { repo, week_start, week_end } = $('Set — week range').first().json;\n\nconst html = `\n  <h2>Еженедельная статистика Issues</h2>\n  <p><b>Репозиторий:</b> ${esc(repo)}<br>\n  <b>Период:</b> ${esc(week_start)} — ${esc(week_end)}<br>\n  <b>Всего Issues:</b> ${total}</p>\n\n  <h3>По типам</h3>\n  <table border=\\\"1\\\" cellpadding=\\\"6\\\" cellspacing=\\\"0\\\">\n    <tr><th>Тип</th><th>Количество</th></tr>\n    ${typeRowsHtml}\n  </table>\n\n  <h3>По авторам</h3>\n  <table border=\\\"1\\\" cellpadding=\\\"6\\\" cellspacing=\\\"0\\\">\n    <tr><th>Автор</th><th>Issues</th></tr>\n    ${authorRowsHtml}\n  </table>\n`;\n\nreturn [{\n  json: { repo, week_start, week_end, total, by_type: byType, by_author: byAuthor, html }\n}];"
      },
