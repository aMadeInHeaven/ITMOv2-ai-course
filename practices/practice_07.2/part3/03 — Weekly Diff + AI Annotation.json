      "id": "1b404522-900b-4dde-9287-0fc80d711d3e",
      "name": "OpenAI Chat Model — weekly annotation",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        3728,
        1280
      ],
      "credentials": {
        "openAiApi": {
          "id": "sez84foWDoPLIrbc",
          "name": "OpenAI account 3"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const source = $('Code — calculate weekly diff').first().json;\nconst aiResult = $input.first().json;\nconst aiComment = [\n  aiResult.text,\n  aiResult.output,\n  aiResult.response,\n  aiResult.message?.content,\n].find((value) => typeof value === 'string' && value.trim())\n  ?? 'AI-комментарий не был получен.';\n\nconst esc = (value) => String(value ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\\\"/g, '&quot;');\n\nconst html = `${source.base_html}\n  <h3>AI-комментарий недели</h3>\n  <p>${esc(aiComment).replace(/\\n/g, '<br>')}</p>`;\n\nreturn [{\n  json: {\n    ...source,\n    ai_comment: aiComment,\n    authors_json: JSON.stringify(source.by_author ?? {}),\n    bug: Number(source.by_type?.bug ?? 0),\n    task: Number(source.by_type?.task ?? 0),\n    feature: Number(source.by_type?.feature ?? 0),\n    needs_triage: Number(source.by_type?.['needs-triage'] ?? 0),\n    html,\n  },\n}];"
      },
