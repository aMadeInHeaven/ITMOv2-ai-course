            }
          ]
        },
        "limit": 1,
        "orderBy": true,
        "orderByColumn": "week_end"
      },
      "id": "640070a4-b079-4fb4-8468-285d6fa67e20",
      "name": "Data Table — get previous week",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        3264,
        1056
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const current = $('When Executed by Another Workflow').first().json;\nconst previous = $input.all()\n  .map((item) => item.json)\n  .find((row) => row && row.week_start && row.repo === current.repo) ?? null;\n\nconst value = (obj, key) => Number(obj?.[key] ?? 0);\nconst diff = (key) => previous ? value(current.by_type, key) - value(previous, key) : null;\nconst totalDiff = previous ? Number(current.total ?? 0) - Number(previous.total ?? 0) : null;\n\nconst esc = (value) => String(value ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\\\"/g, '&quot;');\nconst signed = (n) => n === null ? '—' : `${n > 0 ? '+' : ''}${n}`;\n\nconst deltas = {\n  total: totalDiff,\n  bug: diff('bug'),\n  task: diff('task'),\n  feature: diff('feature'),\n  needs_triage: diff('needs-triage'),\n};\n\nconst deltaHtml = previous\n  ? `<h3>Изменение к прошлой неделе</h3>\n     <table border=\\\"1\\\" cellpadding=\\\"6\\\" cellspacing=\\\"0\\\">\n       <tr><th>Показатель</th><th>Δ</th></tr>\n       <tr><td>Всего Issues</td><td>${signed(deltas.total)}</td></tr>\n       <tr><td>bug</td><td>${signed(deltas.bug)}</td></tr>\n       <tr><td>task</td><td>${signed(deltas.task)}</td></tr>\n       <tr><td>feature</td><td>${signed(deltas.feature)}</td></tr>\n       <tr><td>needs-triage</td><td>${signed(deltas.needs_triage)}</td></tr>\n     </table>`\n  : '<h3>Изменение к прошлой неделе</h3><p>Это первый сохранённый отчёт: сравнивать пока не с чем.</p>';\n\nconst ai_prompt = previous\n  ? `Ты аналитик GitHub Issues. Напиши короткий комментарий на русском: 2–3 предложения, без заголовка и Markdown. Не выдумывай причины, которых нет в цифрах.\\nТекущая неделя ${current.week_start} — ${current.week_end}: всего ${current.total}; bug ${value(current.by_type, 'bug')}; task ${value(current.by_type, 'task')}; feature ${value(current.by_type, 'feature')}; needs-triage ${value(current.by_type, 'needs-triage')}.\\nПредыдущая неделя ${previous.week_start} — ${previous.week_end}: всего ${previous.total}; bug ${previous.bug}; task ${previous.task}; feature ${previous.feature}; needs-triage ${previous.needs_triage}.\\nРазница: всего ${signed(deltas.total)}, bug ${signed(deltas.bug)}, task ${signed(deltas.task)}, feature ${signed(deltas.feature)}, needs-triage ${signed(deltas.needs_triage)}.`\n  : `Ты аналитик GitHub Issues. Это первый сохранённый недельный отчёт по репозиторию ${current.repo}. Напиши одну короткую нейтральную фразу на русском без Markdown: что базовая точка создана и будущий отчёт сможет показать изменение. Текущая статистика: всего ${current.total}, bug ${value(current.by_type, 'bug')}, task ${value(current.by_type, 'task')}, feature ${value(current.by_type, 'feature')}, needs-triage ${value(current.by_type, 'needs-triage')}.`;\n\nreturn [{\n  json: {\n    ...current,\n    previous_week_start: previous?.week_start ?? null,\n    previous_week_end: previous?.week_end ?? null,\n    previous_total: previous?.total ?? null,\n    deltas,\n    delta_html: deltaHtml,\n    base_html: `${current.html}${deltaHtml}`,\n    ai_prompt,\n  },\n}];"
      },
      "id": "b62047b2-56eb-4baa-8e63-830cc2a40481",
      "name": "Code — calculate weekly diff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
