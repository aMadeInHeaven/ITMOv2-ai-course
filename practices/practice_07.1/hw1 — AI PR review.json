    {
      "parameters": {
        "promptType": "define",
        "text": "=Ты опытный code reviewer. Проверь изменения в pull request.\n\nИщи реальные проблемы: баги, небезопасный код, ошибки обработки\nкраевых случаев, утечки ресурсов и нарушения логики.\nНе придирайся к стилю, форматированию или именам без реальной проблемы.\n\nВерни готовый краткий текст review на русском для публикации в GitHub.\nЕсли проблем нет — так и напиши.\n\nИзменения файла:\n{{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "31e7f247-eff5-467e-88a3-540750a43de6",
      "name": "Primary Code Review Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [
        -688,
        -128
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Ты опытный code reviewer. Проверь изменения в pull request.\n\nИщи реальные проблемы: баги, небезопасный код, ошибки обработки\nкраевых случаев, утечки ресурсов и нарушения логики.\nНе придирайся к стилю, форматированию или именам без реальной проблемы.\n\nВерни готовый краткий текст review на русском для публикации в GitHub.\nЕсли проблем нет — так и напиши.\n\nИзменения файла:\n{{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "b73c6f0f-2e56-4034-85b7-dab78af36294",
      "name": "Other Code Review Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [
        -704,
