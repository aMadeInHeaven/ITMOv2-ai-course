        "url": "={{ 'https://api.github.com/repos/' + $('Set — review key').first().json.repo + '/pulls/' + $('Set — review key').first().json.pr_number + '/reviews' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({\n  event: 'COMMENT',\n  body: 'AI inline review',\n  comments: $json.comments\n}) }}",
        "options": {}
      },
      "id": "4757e62b-5942-4fee-89e4-3025298a4cb0",
