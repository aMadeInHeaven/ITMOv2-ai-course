      "id": "d8110343-aeb5-4e63-97d7-a91259514a51",
      "name": "GitHub — Create summary review",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        48,
        128
      ],
      "webhookId": "5093dbeb-98b1-4d50-99ea-eddddfbda7a0",
      "credentials": {
        "githubApi": {
          "id": "Wf05teLwlpfdTJDq",
          "name": "GitHub account 6"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const result = [];\n\nfor (const item of $input.all()) {\n  const file = item.json;\n  const patch = file.patch;\n\n  // GitHub иногда не присылает patch: например, файл слишком большой.\n  if (!file.filename || !patch) continue;\n\n  const changed_lines = [];\n  let newLine = null;\n\n  for (const diffLine of patch.split('\\n')) {\n    // Например: @@ -10,4 +12,7 @@\n    const hunk = diffLine.match(\n      /^@@ -\\d+(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@/\n    );\n\n    if (hunk) {\n      newLine = Number(hunk[1]);\n      continue;\n    }\n\n    if (newLine === null) continue;\n\n    // Добавленная строка: её можно комментировать справа, в новой версии.\n    if (diffLine.startsWith('+') && !diffLine.startsWith('+++')) {\n      changed_lines.push({\n        line: newLine,\n        text: diffLine.slice(1),\n      });\n      newLine++;\n      continue;\n    }\n\n    // Обычная строка контекста тоже занимает строку в новой версии.\n    if (diffLine.startsWith(' ')) {\n      newLine++;\n    }\n\n    // Строка с '-' удалена, поэтому номер новой версии не увеличиваем.\n  }\n\n  if (changed_lines.length > 0) {\n    result.push({\n      json: {\n        path: file.filename,\n        changed_lines,\n      },\n    });\n  }\n}\n\nreturn result;"
      },
      "id": "68bf07cf-a9ff-454e-8772-e80a5a0af043",
      "name": "* Split diff into blocks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1024,
        720
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Ты опытный code reviewer.\n\nПроверь только перечисленные изменённые строки файла.\nИщи реальные проблемы: баги, небезопасный код, ошибку логики,\nнеобработанные крайние случаи. Не комментируй стиль, форматирование\nили названия без настоящей проблемы.\n\nВерни ТОЛЬКО валидный JSON-массив. Без ```json, без пояснений.\n\nФормат каждого замечания:\n{\n  \"path\": \"путь файла\",\n  \"line\": номер изменённой строки,\n  \"body\": \"краткое замечание на русском\"\n}\n\nНельзя указывать строку, которой нет в списке.\nЕсли реальных проблем нет, верни [].\n\nФайл:\n{{ $json.path }}\n\nИзменённые строки:\n{{ JSON.stringify($json.changed_lines) }}",
        "options": {}
      },
      "id": "fd12beb6-7930-4f68-aac3-c933e5e1f448",
      "name": "* Inline Review Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [
        -864,
        720
      ]
    },
    {
      "parameters": {
        "jsCode": "const allowedLines = new Map();\n\n// Берём допустимые path + номера строк из первой Code-ноды.\nfor (const item of $('* Split diff into blocks').all()) {\n  const { path, changed_lines = [] } = item.json;\n  allowedLines.set(\n    path,\n    new Set(changed_lines.map(({ line }) => line)),\n  );\n}\n\nconst comments = [];\n\nfor (const item of $input.all()) {\n  let raw = String(item.json.output ?? '').trim();\n\n  // На случай, если AI всё же завернул JSON в ```json ... ```.\n  raw = raw\n    .replace(/^```(?:json)?\\s*/i, '')\n    .replace(/\\s*```$/i, '')\n    .trim();\n\n  let parsed;\n  try {\n    parsed = JSON.parse(raw);\n  } catch {\n    continue;\n  }\n\n  if (!Array.isArray(parsed)) continue;\n\n  for (const comment of parsed) {\n    const path = String(comment.path ?? '');\n    const line = Number(comment.line);\n    const body = String(comment.body ?? '').trim();\n\n    // Не даём AI прикрепить комментарий к несуществующей строке.\n    if (!body || !allowedLines.get(path)?.has(line)) continue;\n\n    comments.push({\n      path,\n      line,\n      side: 'RIGHT',\n      body,\n    });\n  }\n}\n\nreturn [{ json: { comments } }];"
      },
      "id": "dc7e43eb-e1de-4a71-9dbf-b709bdf14224",
      "name": "* Collect inline comments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        720
